# Source-only allowlist. Local runtime, private settings and media are never staged.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/README.md
!/AGENTS.md
!/THIRD_PARTY_NOTICES.md
!/启动局域网配音.command
!/web/
!/scripts/
!/tests/
!/requirements/
!/config/
!/assets/
!/docs/
!/release/
!/reports/
!/vendor/
/web/*
!/web/*.py
!/web/static/
/web/static/*
!/web/static/*.html
!/web/static/*.js
!/web/static/*.css
/scripts/*
!/scripts/*.py
/tests/*
!/tests/*.py
/requirements/*
!/requirements/*.txt
/config/*
!/config/*.example.json
!/config/native_mlx_runtime.constraints.txt
/assets/*
!/assets/philos_haircut_logo.png
!/assets/philos_club_wordmark.png
!/assets/philos_club_serif_wordmark.png
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/PlayfairDisplay-Variable.ttf
!/assets/fonts/OFL.txt
/docs/*
!/docs/*.md
/release/*
!/release/locked_version.json
/reports/*
!/reports/models.lock.json
/vendor/*
!/vendor/index-tts/
!/vendor/mlx-indextts2-inference/
# Defense in depth for generated files inside allowed source directories.
**/__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
*.pem
*.key
*.p12
*.mp4
*.mov
*.mkv
*.webm
*.mp3
*.m4a
*.wav
*.flac
*.srt
*.ass
*.onnx
*.safetensors
*.pth
*.pt
*.bin
